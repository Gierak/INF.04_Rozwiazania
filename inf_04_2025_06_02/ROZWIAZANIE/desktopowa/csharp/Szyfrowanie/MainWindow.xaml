<Window x:Class="Szyfrowanie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Szyfrowanie"
        mc:Ignorable="d"
        Title="Szyfrowanie. Wykonane przez 12345678901" Height="460" Width="800">
    <Grid Background="CadetBlue">
        <Label Content="Podaj wartość klucza" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Foreground="AntiqueWhite"  FontSize="20" RenderTransformOrigin="0.156,-2.95"/>
        <Label Content="Podaj tekst" HorizontalAlignment="Left" Margin="10,116,0,0" VerticalAlignment="Top" Foreground="AntiqueWhite"  FontSize="20"/>
        <Label Content="Tekst zaszyfrowany" HorizontalAlignment="Left" Margin="435,10,0,0" VerticalAlignment="Top" Foreground="AntiqueWhite"  FontSize="20"/>
        <TextBox x:Name="tb_klucz" HorizontalAlignment="Left" Margin="142,64,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="60"/>
        <TextBox x:Name="tb_tekst" HorizontalAlignment="Left" Margin="10,160,0,0" TextWrapping="Wrap" Text="" AcceptsReturn="True" VerticalAlignment="Top" Width="297" Height="245"/>
        <Button x:Name="ButtonZaszyfruj" Content="Zaszyfruj" Background="LightBlue" HorizontalAlignment="Left" Margin="338,269,0,0" VerticalAlignment="Top" Height="25" Width="61" Click="ButtonZaszyfruj_Click" />
        <Button x:Name="ButtonZapisz" Content="Zapisz szyfr w pliku" Background="LightBlue" HorizontalAlignment="Left" Margin="515,380,0,0" VerticalAlignment="Top" Height="28" Width="182" Click="ButtonZapisz_Click"/>
        <TextBox x:Name="tb_wynik" IsReadOnly="True" HorizontalAlignment="Left" Padding="20,20,20,20" Margin="430,64,0,0" TextWrapping="Wrap" Text="" Foreground="AliceBlue"  VerticalAlignment="Top" Height="297" Width="334" BorderBrush="AntiqueWhite" BorderThickness="3" Background="{x:Null}" FontSize="16">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="30"/>
                </Style>
            </TextBox.Resources>
        </TextBox>

    </Grid>
</Window>

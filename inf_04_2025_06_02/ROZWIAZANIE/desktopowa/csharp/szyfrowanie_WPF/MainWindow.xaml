<Window x:Class="szyfrowanie_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:szyfrowanie_WPF"
        mc:Ignorable="d"
        Background="CadetBlue"
        Title="Szyfrowanie. Wykonane przez 12345678901" Height="450" Width="800">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Content="Podaj wartość klucza" Foreground="AntiqueWhite" FontSize="20" Grid.Row="0"/>
            <TextBox x:Name="textbox_klucz" HorizontalAlignment="Center" Width="60" Height="20" Grid.Row="1" Margin="0,20,0,20"/>
            <Label Content="Podaj tekst" Foreground="AntiqueWhite" FontSize="20" Grid.Row="2" Margin="0,0,0,15"/>
            <TextBox x:Name="textbox_tekst" Grid.Row="3" Margin="16" TextWrapping="Wrap" AcceptsReturn="True" />
        </Grid>

        <Button Content="Zaszyfruj" Grid.Column="1" VerticalAlignment="Center" Margin="20,120,20,20" Padding="5" Background="LightBlue" Click="ButtonZaszyfruj_Click"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Label Content="Tekst zaszyfrowany" Foreground="AntiqueWhite" FontSize="20" Grid.Row="0" Margin="0,0,0,15" />
            <Border BorderBrush="AntiqueWhite" BorderThickness="4" Margin="10" CornerRadius="30" Grid.Row="1" Padding="20,15" >
                <TextBlock x:Name="textblock_wynik" Text="" Foreground="AliceBlue" FontSize="15" TextWrapping="Wrap"/>
            </Border>
            <Button Content="Zapisz szyfr w pliku" Grid.Row="2" Background="LightBlue" HorizontalAlignment="Center" Padding="40,5,40,5" Margin="0,20,0,0" Click="ButtonZapisz_Click"/>
        </Grid>

    </Grid>
</Window>

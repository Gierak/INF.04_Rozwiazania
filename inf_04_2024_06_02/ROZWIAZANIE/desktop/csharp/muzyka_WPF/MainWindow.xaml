<Window x:Class="muzyka_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:muzyka_WPF"
        mc:Ignorable="d"
        Background="SeaGreen"
        Loaded="MainWindow_Load"
        Title="MojeDźwięki, Wykonał: 12345678901" Height="340" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Height="70" Margin="10,0,10,0" Click="Button_poprzedni_Click">
            <Image Source="Images/obraz3.png" Height="70" Stretch="Uniform"/>
        </Button>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Images/obraz.png" Height="200" Stretch="Uniform"/>


                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Label x:Name="label_autor" Content="My Chemical Romance" Foreground="White" FontSize="50"/>
                    <Label x:Name="label_tytul" Content='"The Black Parade"' Foreground="White" FontSize="30" FontStyle="Italic"/>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="label_iloscUtworow" Content="14 utworów" FontSize="20" Foreground="#61D918" Margin="0,0,30,0"/>
                        <Label x:Name="label_rok" Content="2006" FontSize="20" Foreground="#61D918"/>
                    </StackPanel>
                </StackPanel>

            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,30">
                <Label x:Name="label_iloscPobran" Content="304666444" Foreground="#61D918" FontSize="20" Margin="0,0,30,0"/>
                <Button Content="Pobierz" FontSize="20" Background="#61D918" FontWeight="Bold" Padding="10,5,10,5" Click="Button_pobierz_Click" />
            </StackPanel>

        </Grid>


        <Button Grid.Column="2" Height="70" Margin="10,0,10,0" Click="Button_nastepny_Click">
            <Image Source="Images/obraz2.png" Height="70" Stretch="Uniform"/>
        </Button>
    </Grid>
</Window>

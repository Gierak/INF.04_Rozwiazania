<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Beige"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.dp"
        android:layout_marginBottom="15.dp"
        android:background="@color/Brown"
        android:text="Gra w kości. Autor 12345678901"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <Button
        android:id="@+id/button_rzuc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.dp"
        android:backgroundTint="@color/Chocolate"
        android:text="@string/rzuc_koscmi"
        android:textColor="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_marginBottom="10.dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView_kosc1"
            android:layout_width="wrap_content"
            android:layout_height="60.dp"
            android:layout_margin="9dp"

            android:layout_weight="1"
            app:srcCompat="@drawable/question" />

        <ImageView
            android:id="@+id/imageView_kosc2"
            android:layout_width="wrap_content"
            android:layout_height="60.dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/question" />

        <ImageView
            android:id="@+id/imageView_kosc3"
            android:layout_width="wrap_content"
            android:layout_height="60.dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/question" />

        <ImageView
            android:id="@+id/imageView_kosc4"
            android:layout_width="wrap_content"
            android:layout_height="60.dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/question" />

        <ImageView
            android:id="@+id/imageView_kosc5"
            android:layout_width="wrap_content"
            android:layout_height="60.dp"
            android:layout_margin="9dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/question" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView_wynik_losowania"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.dp"
        android:text="@string/wynik_losowania"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/textView_wynik_gry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.dp"
        android:text="@string/wynik_gry"
        android:textAlignment="center" />

    <Button
        android:id="@+id/button_resetuj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/Chocolate"
        android:text="@string/resetuj_wynik"
        android:textColor="@color/white" />
</LinearLayout>
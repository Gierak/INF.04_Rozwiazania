<Window x:Class="paszporty_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:paszporty_WPF"
        mc:Ignorable="d"
        Background="CadetBlue"
        Title="Wprowadzanie danych do paszportu. Wykonał: 12345678901" Height="330" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Label Content="Numer" Width="80" Margin="5,5,55,5"/>
                <TextBox x:Name="textBox_numer" Margin="7" Background="Azure" VerticalContentAlignment="Center" LostFocus="TextBox_numer_Leave" />
            </DockPanel>

            <DockPanel Grid.Row="1">
                <Label Content="Imię" Width="80" Margin="5,5,55,5"/>
                <TextBox x:Name="textBox_imie" Margin="7" Background="Azure" VerticalContentAlignment="Center"/>
            </DockPanel>

            <DockPanel Grid.Row="2">
                <Label Content="Nazwisko" Width="80" Margin="5,5,55,5"/>
                <TextBox x:Name="textBox_nazwisko" Margin="7" Background="Azure" VerticalContentAlignment="Center"/>
            </DockPanel>

            <GroupBox Grid.Row="4" Header="Kolor oczu">
                <StackPanel>
                    <RadioButton Content="niebieskie" Margin="15,15,5,5" IsChecked="True" Click="RadioButton1_Click" />
                    <RadioButton Content="zielone" Margin="15,10,5,5" Click="RadioButton1_Click"/>
                    <RadioButton Content="piwne" Margin="15,10,5,15" Click="RadioButton1_Click"/>
                </StackPanel>
            </GroupBox>

        </Grid>

        <Grid Grid.Column="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="Image_osoba" Grid.Column="0" Source="/Images/000-zdjecie.jpg" Height="180" Stretch="Uniform"/>

                <Image x:Name="Image_odcisk" Grid.Column="2" Source="/Images/000-odcisk.jpg" Height="180" Stretch="Uniform"/>

            </Grid>

            <Button Grid.Row="1" Content="OK" Padding="7" Width="200" Background="Azure" Click="Button_ok_Click"/>

        </Grid>

    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView_kosc1"
            android:layout_width="99dp"
            android:layout_height="99dp"
            android:layout_margin="10dp"
            android:tag="1"
            app:srcCompat="@drawable/kosc0" />

        <ImageView
            android:id="@+id/imageView_kosc2"
            android:layout_width="99dp"
            android:layout_height="99dp"
            android:layout_margin="10dp"
            android:tag="2"
            app:srcCompat="@drawable/kosc0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView_kosc3"
            android:layout_width="99dp"
            android:layout_height="99dp"
            android:layout_margin="10dp"
            android:tag="3"
            app:srcCompat="@drawable/kosc0" />

        <ImageView
            android:id="@+id/imageView_kosc4"
            android:layout_width="99dp"
            android:layout_height="99dp"
            android:layout_margin="10dp"
            android:tag="4"
            app:srcCompat="@drawable/kosc0" />

        <ImageView
            android:id="@+id/imageView_kosc5"
            android:layout_width="99dp"
            android:layout_height="99dp"
            android:layout_margin="10dp"
            android:tag="5"
            app:srcCompat="@drawable/kosc0" />
    </LinearLayout>

    <Button
        android:id="@+id/button_rzut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:backgroundTint="@color/dark_green"
        android:text="@string/rzut" />

    <TextView
        android:id="@+id/textView_wynik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="40sp" />
</LinearLayout>